    {
      "id": "claim_f86ab45216ef4bba99e9b1497aea5d87",
      "statement": "Cybflight's Error-State Kalman Filter (ESKF) uses a 15-state error state vector (delta pos, delta att, delta vel, delta accel_bias, delta gyro_bias) to estimate 3D position, unit quaternion orientation, linear velocity, accelerometer bias, and gyroscope bias in the ENU reference frame, propagating nominal states via boxplus updates.",
      "evidence": [
        {
          "resource": "repo://crates/cybflight_core/src/eskf/eskf.rs#L203-L236",
          "version": "repo-lines-v1:sha256:2bd1f5bed11bdffcffb10ee823332e31cd1c6bfc330ce4cda74ac62793cb9210:"
        }
      ]
    },
    {
      "id": "claim_1b7ac3f8ee674d1d84ad91e7e9d46d56",
      "statement": "The ESKF provides a block-sparse prediction step (predict_sparse) that exploits the structural zeros of the 15x15 error state transition matrix F to compute F P F^T + Q in ~1,100 FMAs compared to ~6,750 FMAs for the dense product while enforcing exact upper-triangle symmetry.",
      "evidence": [
        {
          "resource": "repo://crates/cybflight_core/src/eskf/eskf.rs#L400-L639",
          "version": "repo-lines-v1:sha256:15dbaecc33e142116aa321314ce0da3fdd92f5e8ad26ca289ffebf14883fa7e2:"
        }
      ]
    },
